# Settings for the apptracker binary. Every value is optional in development;
# the defaults are shown. The binary reads the environment only (it does not
# load this file), so export these or pass them to your process manager.

# development or production. Production: Secure + __Host- session cookie,
# HSTS, and no /swagger.
APP_ENV=development

# Public origin of the app. Must be https:// in production (the server refuses
# to start otherwise). Origin only: no path.
APP_URL=http://localhost:5173

# Set to true only if a proxy rewrites the Host header; the CSRF check then
# also trusts exactly APP_URL as an Origin.
TRUST_APP_URL_ORIGIN=false

# Reverse proxies in front of the server, as comma-separated IPs or CIDR
# ranges (e.g. 172.16.0.0/12 for a Docker network). The client address for
# the login rate limit is then read from X-Forwarded-For. Leave empty when
# clients connect directly; set it whenever a proxy is in front, or every
# client shares the proxy's rate-limit bucket.
TRUSTED_PROXIES=

# SQLite database file (created and migrated on start).
DB_PATH=data/app.db

# Resume PDFs are stored under DATA_DIR/resumes/<userId>/<uuid>.pdf.
DATA_DIR=data

# Listen port. In development Vite (5173) proxies /api here.
PORT=8080
